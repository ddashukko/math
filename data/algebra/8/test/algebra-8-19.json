{
  "id": "algebra-8-19-test",
  "title": "Тест: § 19. Функція y = √x",
  "type": "test",
  "exercises": [
    {
      "id": "test-group",
      "title": "Контрольний тест",
      "tasks": [
        {
          "id": "1",
          "q": "Знайдіть значення функції \\(y = \\sqrt{x}\\), якщо аргумент дорівнює 144.",
          "choices": ["11", "12", "13", "72"],
          "a": ["12"],
          "type": "choice"
        },
        {
          "id": "2",
          "q": "Яка область визначення функції \\(y = \\sqrt{x}\\)?",
          "choices": [
            "Всі числа",
            "Тільки додатні числа",
            "Невід'ємні числа (x ≥ 0)",
            "Всі числа, крім 0"
          ],
          "a": ["Невід'ємні числа (x ≥ 0)"],
          "type": "choice"
        },
        {
          "id": "3",
          "q": "Чи проходить графік функції \\(y = \\sqrt{x}\\) через точку \\(A(25; -5)\\)?",
          "choices": ["Так", "Ні"],
          "a": ["Ні"],
          "type": "choice"
        },
        {
          "id": "4",
          "q": "Порівняйте числа \\(2\\sqrt{5}\\) і \\(\\sqrt{21}\\).",
          "choices": [
            "2√5 > √21",
            "2√5 < √21",
            "2√5 = √21",
            "Неможливо порівняти"
          ],
          "a": ["2√5 < √21"],
          "type": "choice"
        },
        {
          "id": "5",
          "q": "Розв'яжіть рівняння \\(\\sqrt{x} = 9\\).",
          "choices": ["3", "81", "18", "9"],
          "a": ["81"],
          "type": "choice"
        },
        {
          "id": "6",
          "q": "Вкажіть корінь рівняння \\(\\sqrt{x} = -4\\).",
          "choices": ["16", "-16", "2", "Коренів немає"],
          "a": ["Коренів немає"],
          "type": "choice"
        },
        {
          "id": "7",
          "q": "У якій чверті координатної площини лежить графік функції \\(y = \\sqrt{x}\\)?",
          "choices": ["I", "II", "III", "IV"],
          "a": ["I"],
          "type": "choice"
        },
        {
          "id": "8",
          "q": "Знайдіть значення виразу \\(4\\sqrt{3} - \\sqrt{48}\\).",
          "choices": ["0", "√3", "2√3", "4"],
          "a": ["0"],
          "type": "choice"
        },
        {
          "id": "9",
          "q": "При якому значенні \\(x\\) значення функції \\(y = \\sqrt{x}\\) дорівнює 1.5?",
          "choices": ["3", "2.25", "1.25", "2.5"],
          "a": ["2.25"],
          "type": "choice"
        },
        {
          "id": "10",
          "q": "Порівняйте \\(\\frac{1}{2}\\sqrt{32}\\) і \\(2\\sqrt{2}\\).",
          "choices": ["<", ">", "="],
          "a": ["="],
          "type": "choice"
        },
        {
          "id": "11",
          "q": "Скільки спільних точок мають графіки функцій \\(y = \\sqrt{x}\\) і \\(y = 5\\)?",
          "choices": ["Жодної", "Одну", "Дві", "Безліч"],
          "a": ["Одну"],
          "type": "choice"
        },
        {
          "id": "12",
          "q": "Визначте область значень функції \\(y = \\sqrt{x}\\), якщо \\(4 \\le x \\le 16\\).",
          "choices": ["2 ≤ y ≤ 4", "4 ≤ y ≤ 16", "2 ≤ y ≤ 8", "0 ≤ y ≤ 4"],
          "a": ["2 ≤ y ≤ 4"],
          "type": "choice"
        }
      ]
    }
  ]
}
