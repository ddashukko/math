      "title": "Контрольний тест",
      "tasks": [
        {
          "id": "1",
          "q": "Вкажіть, яке з наведених рівнянь є повним квадратним рівнянням:",
          "choices": [
            "\\(x^2 - 4 = 0\\)",
            "\\(2x^2 + 3x - 5 = 0\\)",
            "\\(x^2 + 3x = 0\\)",
            "\\(0x^2 + 2x - 1 = 0\\)"
          ],
          "a": "\\(2x^2 + 3x - 5 = 0\\)",
          "type": "choice"
        },
        {
          "id": "2",
          "q": "Визначте коефіцієнти \\(a, b, c\\) рівняння \\(5 - 2x + x^2 = 0\\).",
          "choices": [
            "a=5, b=-2, c=1",
            "a=1, b=5, c=-2",
            "a=1, b=-2, c=5",
            "a=-2, b=1, c=5"
          ],
          "a": "a=1, b=-2, c=5",
          "type": "choice"
        },
        {
          "id": "3",
          "q": "Яке з наведених рівнянь є зведеним квадратним рівнянням?",
          "choices": [
            "\\(2x^2 + x - 3 = 0\\)",
            "\\(-x^2 + 2x + 4 = 0\\)",
            "\\(x^2 - 5x + 1 = 0\\)",
            "\\(4x^2 - 1 = 0\\)"
          ],
          "a": "\\(x^2 - 5x + 1 = 0\\)",
          "type": "choice"
        },
        {
          "id": "4",
          "q": "Знайдіть корені рівняння \\(4x^2 = 0\\).",
          "choices": ["0", "4", "0; 4", "коренів немає"],
          "a": "0",
          "type": "choice"
        },
        {
          "id": "5",
          "q": "Розв'яжіть рівняння \\(2x^2 - 18 = 0\\).",
          "choices": ["3", "-3", "3; -3", "9; -9"],
          "a": "3; -3",
          "type": "choice"
        },
        {
          "id": "6",
          "q": "Скільки коренів має рівняння \\(x^2 + 9 = 0\\)?",
          "choices": ["Один", "Два", "Безліч", "Жодного"],
          "a": "Жодного",
          "type": "choice"
        },
        {
          "id": "7",
          "q": "Знайдіть корені рівняння \\(x^2 - 7x = 0\\).",
          "choices": ["0; -7", "0; 7", "7", "коренів немає"],
          "a": "0; 7",
          "type": "choice"
        },
        {
          "id": "8",
          "q": "Знайдіть корені рівняння \\(5x^2 + 2x = 0\\).",
          "choices": ["0; 0.4", "0; -0.4", "0; 2.5", "0; -2.5"],
          "a": "0; -0.4",
          "type": "choice"
        },
        {
          "id": "9",
          "q": "Знайдіть число \\(a\\), якщо відомо, що число 2 є коренем рівняння \\(ax^2 - 3x - 2 = 0\\).",
          "choices": ["2", "1", "-2", "0.5"],
          "a": "2",
          "type": "choice"
        },
        {
          "id": "10",
          "q": "Розв'яжіть рівняння \\((x-3)(x+2) = -6\\).",
          "choices": ["3; -2", "0; 1", "0", "1; -6"],
          "a": "0; 1",
          "type": "choice"
        },
        {
          "id": "11",
          "q": "При якому значенні \\(c\\) рівняння \\(2x^2 + c = 0\\) має корені \\(\\pm 3\\)?",
          "choices": ["18", "-18", "9", "-9"],
          "a": "-18",
          "type": "choice"
        },
        {
          "id": "12",
          "q": "Розв'яжіть рівняння \\(|x^2 - x| = 0\\).",
          "choices": ["0; 1", "0; -1", "1", "0"],
          "a": "0; 1",
          "type": "choice"
        }
      ]
