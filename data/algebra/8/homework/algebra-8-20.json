{
  "id": "algebra-8-20-hw",
  "title": "Домашнє завдання: § 20. Квадратні рівняння",
  "type": "homework",
  "exercises": [
    {
      "id": "HW.20.5",
      "title": "Заповнення таблиці",
      "tasks": [
        {
          "id": "1)",
          "q": "Для рівняння \\(5x^2 - 3x - 17 = 0\\) вкажіть коефіцієнти \\(a, b, c\\) (через крапку з комою).",
          "a": ["5; -3; -17"],
          "type": "input"
        },
        {
          "id": "2)",
          "q": "Складіть рівняння, якщо \\(a=2, b=-3, c=4\\) (без пробілів).",
          "a": ["2x^2-3x+4=0"],
          "type": "input"
        },
        {
          "id": "3)",
          "q": "Складіть рівняння, якщо \\(a=-3, b=0, c=7\\) (без пробілів).",
          "a": ["-3x^2+7=0"],
          "type": "input"
        },
        {
          "id": "4)",
          "q": "Для рівняння \\(-x^2 + 5x + 6 = 0\\) вкажіть коефіцієнти \\(a, b, c\\).",
          "a": ["-1; 5; 6"],
          "type": "input"
        },
        {
          "id": "5)",
          "q": "Складіть рівняння, якщо \\(a=-5, b=-1, c=19\\).",
          "a": ["-5x^2-x+19=0", "-5x^2-1x+19=0"],
          "type": "input"
        }
      ]
    },
    {
      "id": "HW.20.6",
      "title": "Зведення до вигляду ax² + bx + c = 0",
      "tasks": [
        {
          "id": "1)",
          "q": "Зведіть до квадратного рівняння: \\((5x-1)(5x+1) = x(7x-13)\\). Напишіть отримане рівняння (наприклад: 18x^2+13x-1=0).",
          "a": ["18x^2+13x-1=0"],
          "type": "input"
        },
        {
          "id": "2)",
          "q": "Зведіть до квадратного рівняння: \\((2x-3)^2 = (x+2)(x-7)\\).",
          "a": ["3x^2-7x+23=0"],
          "type": "input"
        }
      ]
    },
    {
      "id": "HW.20.9",
      "title": "Перевірка коренів",
      "tasks": [
        {
          "id": "1)",
