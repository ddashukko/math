          "a": "0",
          "type": "choice"
        },
        {
          "id": "3)",
          "q": "Які із чисел -5; -2; 0; 2; 5 є коренями рівняння \\(x^2 - x - 6 = 0\\)?",
          "choices": ["-2", "3", "-2; 3", "2; -3"],
          "a": "-2",
          "type": "choice"
        },
        {
          "id": "4)",
          "q": "Які із чисел -5; -2; 0; 2; 5 є коренями рівняння \\(x^2 - 25 = 0\\)?",
          "choices": ["5; -5", "5", "-5", "25"],
          "a": "5; -5",
          "type": "choice"
        }
      ]
    },
